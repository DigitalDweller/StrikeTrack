{
  "name": "striketrack",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start:lan": "expo start --lan",
    "start:lan:win": "powershell -ExecutionPolicy Bypass -File ./scripts/start-lan.ps1",
    "start:tunnel": "expo start --tunnel",
    "start:usb": "powershell -ExecutionPolicy Bypass -File ./scripts/start-usb.ps1",
    "start:localhost": "expo start --localhost",
    "start:clear": "expo start -c",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:ios": "eas build --platform ios",
    "build:web": "expo export -p web && npx workbox generateSW workbox-config.js",
    "offline": "npm run build:web && npx serve dist -p 3000",
    "doctor": "npx expo-doctor@latest",
    "fix": "expo install --fix",
    "firewall": "powershell -ExecutionPolicy Bypass -File ./scripts/add-firewall-rules.ps1"
  },
  "dependencies": {
    "expo": "~52.0.0",
    "expo-asset": "~11.0.5",
    "expo-constants": "~17.0.8",
    "expo-image-picker": "~16.0.0",
    "expo-linking": "~7.0.5",
    "expo-notifications": "^0.29.14",
    "expo-router": "~4.0.0",
    "expo-sqlite": "~15.1.4",
    "expo-status-bar": "~2.0.0",
    "react": "18.3.1",
    "react-native": "0.76.9",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-web": "~0.19.13"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~18.3.12",
    "babel-plugin-module-resolver": "^5.0.0",
    "typescript": "~5.3.0",
    "workbox-cli": "^7.0.0"
  },
  "private": true
}
